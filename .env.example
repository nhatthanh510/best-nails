NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used by the kiosk Server Actions after the paired device is verified.
SUPABASE_SECRET_KEY=sb_secret_...
# Public site URL (e.g. https://rewards.bestnails.com.au). Used for share previews and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only. Google Gemini API key for the admin's "Ask the shop" assistant (free at https://aistudio.google.com/apikey).
# Optional: the page explains it isn't set up without it. On the free tier Google may use prompts to improve its products.
GEMINI_API_KEY=
